OPENCODE_URL=http://127.0.0.1:4096
OPENCODE_MODEL=opencode/glm-5.3-flash-free
# JWT_SECRET=<random 32+ bytes>; omitted -> generated once into the SQLite settings table
# ADMIN_USER=admin            # the admin login; ADMIN_USERS=a,b for several
# ADMIN_PASSWORD=<set one>     # seeded on first start; without it no admin account is created
# OPENALEX_API_KEY=<free key from openalex.org>; without one the shared per-IP daily budget runs out and OpenAlex just stops answering
# S2_API_KEY=<free key from semanticscholar.org/product/api>; the anonymous pool is shared by everyone and often returns 429
